{
  "name": "automation-rms",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E automation and QA documentation for ALLWEB RMS (Recruitment Management System)",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium --project=chromium-writes",
    "test:headed": "playwright test --headed",
